# Copy this file to .env and fill in your own values.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name. Run `python scripts/check_gemini.py` to list the ones your key can use.
GEMINI_MODEL=gemini-3.5-flash

# Optional: overrides "today" for date-based policy checks (YYYY-MM-DD).
# Leave empty to use the real current date.
STORE_TODAY=
