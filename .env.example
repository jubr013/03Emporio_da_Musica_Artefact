# Copy this file to .env and fill in your own values.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model name. Run `python scripts/check_gemini.py` to list the ones your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used automatically if GEMINI_MODEL's daily quota runs out (has its own free quota). Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: overrides "today" for date-based policy checks.
# YYYY-MM-DD changes only the date; YYYY-MM-DDTHH:MM also sets the time (e.g. 2026-11-07T14:00 for after hours).
# Leave empty to use the real current date and time.
STORE_TODAY=
